{
    "manifest-version": 3,
    "name": "capell-app/widget-data-chart",
    "slug": "widget-data-chart",
    "displayName": "Data Chart Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Validated bar, line, and donut charts rendered as server-side SVG with an accessible HTML table.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetDataChart",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetDataChart\\Providers\\WidgetDataChartServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.data-chart",
            "class": "Capell\\WidgetDataChart\\WidgetDataChartContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-data-chart",
            "class": "Capell\\WidgetDataChart\\WidgetDataChartContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 15,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-data-chart"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-data-chart.package-health",
            "label": "Data Chart widget package health",
            "class": "Capell\\WidgetDataChart\\Health\\WidgetDataChartHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Server-rendered charts with patterns, labels, and accessible tables.",
        "description": "Turn a small editorial dataset into a bar, line or donut chart that is drawn on the server, with a complete accessible data table beside it and no client charting service. Requires Layout Builder. Limits: one to eight series of up to fifty labelled numbers each; donut charts need non-negative values.",
        "problem": "Readers can find a set of figures difficult to interpret without a visual comparison.",
        "outcome": "A page has a chart accompanied by its values in a table.",
        "faq": [
            {
                "question": "Which chart formats are supported?",
                "answer": "Editors can choose bar, line or donut charts."
            },
            {
                "question": "Can visitors read the underlying values?",
                "answer": "Yes. Public output includes an accessible data table alongside the chart."
            },
            {
                "question": "How much data fits in a chart?",
                "answer": "A chart supports 1 to 8 series with 1 to 50 points per series."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-data-chart-public-output.png",
                "alt": "Data Chart public output",
                "caption": "Data Chart public output"
            },
            {
                "path": "docs/assets/marketplace/listing-data-chart-layout-builder-editor.png",
                "alt": "Data Chart fields in Layout Builder",
                "caption": "Data Chart fields in Layout Builder"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Data Chart widget preview",
                "caption": "Data Chart widget"
            }
        ],
        "categories": ["foundation", "frontend", "data"]
    }
}
