{
    "name": "capell-app/widget-data-chart",
    "description": "Accessible server-rendered data chart widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^4.0",
        "capell-app/core": "^4.0",
        "capell-app/frontend": "^4.0",
        "capell-app/layout-builder": "^4.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetDataChart\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetDataChart\\Providers\\WidgetDataChartServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
